{
  "name": "gemmacode",
  "private": true,
  "version": "0.0.0",
  "description": "Локальный кроссплатформенный ИИ-агент на Gemma 4",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:eval",
    "build": "npm run build --workspaces --if-present",
    "bench": "node bench/bench.mjs",
    "test:eval": "node --experimental-strip-types --test --test-concurrency=4 eval/*.test.ts",
    "eval": "node --experimental-strip-types eval/run.ts",
    "gemmacode": "node packages/cli/bin/gemmacode.mjs"
  }
}
